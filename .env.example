# ===== LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）=====
# 当前激活的供应源: "network" (云端) 或 "local" (本地)
LLM_PROVIDER=network

# 云端 LLM API 配置
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 或 DeepSeek：https://platform.deepseek.com/
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat

# 本地 LLM API 配置（Ollama / LM Studio / vLLM 等 OpenAI 兼容接口）
# Ollama 默认地址: http://localhost:11434/v1
# LM Studio 默认地址: http://localhost:1234/v1
# vLLM 默认地址: http://localhost:8000/v1
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL_NAME=qwen2.5:7b

# 注意：本项目不需要 ZEP_API_KEY。
# 知识图谱已完全本地化（SQLite + LocalGraphClient），不依赖 Zep Cloud，
# 也不需要任何图谱服务的密钥。历史上这里曾有 ZEP_API_KEY，现已移除。

# ===== 文档 OCR 配置（可选，也可在界面「设置 → 文档解析」里改）=====
# 引擎: auto（本地优先，默认）/ vision（只用本地）/ api（只用视觉大模型）/ off（关闭）
# 本地 Vision 由 macOS 提供，免费、离线、无需密钥，需要装：uv sync --extra ocr-macos
OCR_ENGINE=auto
# 扫描版 PDF 是否自动 OCR（逐页判定，约 1 秒/页）
OCR_SCAN_PDF=true
# 单份文档最多 OCR 多少页
OCR_MAX_PAGES=30
# 仅当 OCR_ENGINE=api 时使用：OpenAI 兼容的视觉模型
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL_NAME=qwen-vl-max
